{
  "name": "epic-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "node scripts/prepare-prisma.mjs && prisma generate && (prisma db push || exit 0) && (node scripts/seed-admin.mjs || exit 0) && next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "geo:qa": "node scripts/geo-qa.mjs",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "db:seed": "node scripts/seed-admin.mjs",
    "postinstall": "node scripts/prepare-prisma.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/matter-js": "^0.20.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "matter-js": "^0.20.0",
    "next": "16.2.12",
    "nodemailer": "^10.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
